#!/usr/bin/env sh
# push 前に、これから push する差分とコミットメッセージを安価なモデル（既定は Claude Haiku）に読ませ、
# 公開リポジトリに出せない内容（顧客名・商談・価格・内部構成など）がありそうなら人に確認を求める。
#
# - 端末があれば y/N を聞く。無ければ（AI エージェントの実行など）push を止める
# - 人が内容を確かめて push すると決めたときだけ、人が CRE_PUSH_REVIEWED=1 git push を実行する。AI は付けない
# - レビュアーは claude CLI（無ければ codex CLI）。CRE_PUSH_REVIEWER=claude|codex、CRE_PUSH_REVIEW_MODEL で変えられる
# 有効化: vp install（package.json の prepare が core.hooksPath を設定する）
set -u

remote="$1"
zero=0000000000000000000000000000000000000000

if [ "${CRE_PUSH_REVIEWED:-}" = "1" ]; then
  echo "pre-push: CRE_PUSH_REVIEWED=1 なので、人が確認済みとして push します" >&2
  exit 0
fi

# push するコミットの差分（追加行だけ）とメッセージを集める。lockfile は除く。
# 送信先に既にある行（番号を振り直した・別のファイルへ移した・公開済みの文を引用した行）は、公開済みなので審査から除く
content=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # ブランチの削除
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$remote" # 新しいブランチ: 送信先に無いコミット
  else
    range="$remote_sha..$local_sha"
  fi
  # 読めなければ止める（fetch していない状態での force-push など。黙って通すと未審査のまま公開される）
  # shellcheck disable=SC2086
  messages=$(git log --format='commit %h%n%s%n%b' $range) || {
    echo "pre-push: push するコミットを読めません（$range）。fetch してから push し直してください" >&2
    exit 1
  }
  # 注釈付きタグは、タグオブジェクトのメッセージも読ませる（git log はコミットしか見ない）
  case "$local_ref" in
    refs/tags/*)
      if [ "$(git cat-file -t "$local_sha")" = tag ]; then
        messages="タグ $local_ref
$(git cat-file -p "$local_sha")
$messages"
      fi ;;
  esac
  # --diff-merges=first-parent: マージコミット（コンフリクト解消で足した行）の差分も出す
  # shellcheck disable=SC2086
  patch=$(git log -p --unified=0 --no-color --diff-merges=first-parent --format='commit %h' $range -- . ':(exclude)pnpm-lock.yaml') || {
    echo "pre-push: push する差分を読めません（$range）。fetch してから push し直してください" >&2
    exit 1
  }
  # 差分からは削除行を落とす（メッセージには適用しない。箇条書きの「- 」が消えるため）
  patch=$(printf '%s\n' "$patch" | grep -v '^-' || true)
  # 送信先に既にある行を落とす。比べる先は、送信先のブランチ（あれば）か、送信先の main との分岐点
  if [ "$remote_sha" != "$zero" ]; then
    base="$remote_sha"
  else
    base=$(git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null || git merge-base "$local_sha" "refs/remotes/$remote/HEAD" 2>/dev/null || true)
  fi
  if [ -n "$base" ]; then
    patch=$(printf '%s\n' "$patch" | awk -v base="$base" '
      BEGIN { cmd = "git grep -I -h -e \"\" " base; while ((cmd | getline line) > 0) seen[line] = 1; close(cmd) }
      /^\+\+\+ / { print; next }
      /^\+/ { if (substr($0, 2) in seen) { dropped++; next } }
      { print }
      END { if (dropped) printf "pre-push: 送信先に既にある行 %d 行を審査から除きました\n", dropped > "/dev/stderr" }')
  fi
  content="$content
push 先: $remote_ref
# コミットメッセージ
$messages
# 追加行
$patch"
done
if [ -z "$(printf '%s' "$content" | tr -d '[:space:]')" ]; then
  exit 0
fi

system='あなたは、比較的小規模な企業が公開している GitHub リポジトリ cre-run/cre（製品 CRE / cre.run のコードとドキュメント）への push を、公開前に審査するレビュアーです。
これから push されるコミットのメッセージと追加行を読み、公開してはいけない内容が含まれていないかを判断してください。

公開してはいけない内容:
- 顧客・見込み顧客・取引先の名前や、それを推測できる情報。商談・契約・売上・価格の検討
- 採用計画、資金、競合分析の結論などの経営情報
- 内部のホスト名・アカウント ID・トークン・鍵・メールアドレス・個人情報
- 非公開リポジトリ（cre-private）や内部資料の内容の引用・要約。CONFIDENTIAL の印
- 管理用の経路の実際の値（内部 API や管理画面の実在する URL・ホスト名、アカウント ID、社内だけの手順書の引用）

指摘しなくてよいもの:
- 製品名 CRE / cre.run、公開済みの URL、OSS のパッケージ名、example.com などの見本、`<...>` のプレースホルダー、テストの架空データ（偽の User-Agent・メール・UUID など）、コードの識別子
- このリポジトリで公開している製品そのものの設計・設定・運用の説明。Cloudflare Workers・D1・Access・Service Binding の設定方法、デプロイや開発の手順、セルフホストの手順は、公開するドキュメントとして書いています
- 外部サービスの公開されている仕様（Slack の文字数の上限など）や、公開されている技術情報

指摘するのは、特定の顧客・人・内部の環境を指す固有名詞や実際の値（名前、ホスト名、ID、メールアドレス、金額、商談の内容）が書かれているときです。設計や手順の一般的な説明は、それだけでは指摘しません。

バイナリ（画像・PDF など。差分には「Binary files ... differ」とだけ出ます）は内容を読めません。ファイル名やコミットメッセージから、内部の画面の撮影や社内文書など公開してはいけないものの可能性があれば REVIEW にしてください。

迷ったら、その箇所から「誰の・どこの・どの値か」を特定できるかで決めてください。特定できるなら指摘し（人が最終判断します）、できないなら指摘しません。
出力は次の形式だけにしてください。1 行目は OK か REVIEW のどちらか 1 語。REVIEW のときは 2 行目以降に「- 場所: 該当箇所の短い引用 — 理由」を 1 件 1 行で書く。'

# 大きすぎて読ませ切れないときは、モデルに聞かずに人の確認へ回す（先頭だけ見た OK で通さない）
limit=400000
if [ "$(printf '%s' "$content" | wc -c)" -gt "$limit" ]; then
  echo "pre-push: push する内容が $limit バイトを超えていて、モデルに読ませ切れません。人の確認が必要です" >&2
  reviewer=none
else
  reviewer="${CRE_PUSH_REVIEWER:-}"
fi
if [ "$reviewer" = none ]; then
  answer="REVIEW
- 全体: 内容が大きすぎてモデルに読ませていません — 人が差分を確かめてください"
elif [ -z "$reviewer" ]; then
  if command -v claude >/dev/null 2>&1; then reviewer=claude
  elif command -v codex >/dev/null 2>&1; then reviewer=codex
  else
    echo "pre-push: AI レビューに使う claude か codex の CLI が見つかりません。入れるか、人が確かめて CRE_PUSH_REVIEWED=1 を付けてください" >&2
    exit 1
  fi
fi

case "$reviewer" in
  none) ;;
  claude)
    model="${CRE_PUSH_REVIEW_MODEL:-claude-haiku-5-5}"
    answer=$(printf '%s\n' "$content" | env -u CLAUDECODE claude -p "上の内容を審査してください" \
      --model "$model" --system-prompt "$system" --output-format text --no-session-persistence --tools "") ;;
  codex)
    model="${CRE_PUSH_REVIEW_MODEL:-}"
    out=$(mktemp)
    { printf '%s\n\n---\n\n' "$system"; printf '%s\n' "$content"; } |
      codex exec --sandbox read-only --skip-git-repo-check --ephemeral --color never -o "$out" ${model:+-m "$model"} >/dev/null
    answer=$(cat "$out"); rm -f "$out" ;;
  off)
    echo "pre-push: CRE_PUSH_REVIEWER=off なので AI レビューを飛ばします" >&2
    exit 0 ;;
  *)
    echo "pre-push: CRE_PUSH_REVIEWER=$reviewer は不明です（claude | codex | off）" >&2
    exit 1 ;;
esac
status=$?
if [ "$status" -ne 0 ] || [ -z "$answer" ]; then
  echo "pre-push: AI レビュー（$reviewer）を実行できませんでした。もう一度試すか、人が確かめて CRE_PUSH_REVIEWED=1 を付けてください" >&2
  exit 1
fi

case "$(printf '%s' "$answer" | head -1 | tr -d '[:space:]')" in
  OK)
    echo "pre-push: AI レビュー（$reviewer ${model:-}）: 問題なし" >&2
    exit 0 ;;
esac

if [ "$reviewer" = none ]; then
  echo "pre-push: 人の確認が必要です" >&2
else
  echo "pre-push: AI レビュー（$reviewer ${model:-}）で、人の確認が必要です" >&2
fi
printf '%s\n' "$answer" | tail -n +2 >&2
# 端末があれば人に聞く（開けるかどうかの確認だけを静かに行い、質問は端末に出す）
if ( : </dev/tty ) 2>/dev/null; then
  printf '\n公開リポジトリに push してよいですか？ [y/N] ' >&2
  read -r yn </dev/tty || yn=""
  case "$yn" in
    y | Y | yes) echo "人の確認を得たので push します" >&2; exit 0 ;;
  esac
  echo "push を止めました" >&2
  exit 1
fi
echo "" >&2
echo "端末が無いので人に確認できません。push を止めました。人が上の指摘を確かめ、問題なければ人が端末から git push するか、CRE_PUSH_REVIEWED=1 を付けて push してください（AI エージェントは付けないこと）" >&2
exit 1
