{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cre-docs",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "docs.cre.run", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
