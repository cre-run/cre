{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cre-docs",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "docs.cre.run", "custom_domain": true }],
  // 本番は docs.cre.run のみで配信し、<name>.<subdomain>.workers.dev は使わない
  "workers_dev": false,
  // PR ごとの Worker Previews（pr-<番号>-cre-docs.<subdomain>.workers.dev）を有効にする
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
