{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-confidential.mjs\" --tool-input"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-confidential.mjs\" --if-git-commit"
          }
        ]
      }
    ]
  }
}
