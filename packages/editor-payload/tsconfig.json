{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* node が型を剥がすだけで実行できる構文に限る（scripts/encode.ts が node で直接読み込む） */
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  }
}
